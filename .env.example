# Copy to .env and fill in. .env is gitignored.
QC_BASE_URL=http://localhost:8000
QC_DB_URL=sqlite:///./quantumcert.db
QC_KEYS_DIR=keys
# Passphrase that encrypts the issuer private key at rest (keys/private/<key_id>.sk.json)
QC_KEY_PASSPHRASE=change-me-to-a-long-random-passphrase
# Secret for signing admin session cookies
QC_SESSION_SECRET=change-me-to-another-long-random-string
